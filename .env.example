# Tower Server Configuration
# Copy this file to .env and fill in your values

# Timezone
TZ=America/New_York

# User/Group IDs (run 'id' command to get your values)
PUID=1000
PGID=1000

# Network Configuration
DOMAIN=example.com

# Paths - Adjust these to match your Unraid share paths
DATA_PATH=/mnt/user/appdata
MEDIA_PATH=/mnt/user/media
DOWNLOADS_PATH=/mnt/user/downloads

# Portainer Configuration
PORTAINER_PORT=9000

# Example service ports (uncomment and configure as needed)
# NGINX_PORT=80
# NGINX_SSL_PORT=443
# HEIMDALL_PORT=8080
# PLEX_PORT=32400
# SONARR_PORT=8989
# RADARR_PORT=7878
# JELLYFIN_PORT=8096
